{
  "name": "mister-sscraper",
  "version": "6.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check server/platformCatalog.js && node --check server/cache.js",
    "test": "node --test",
    "ci": "npm run check && npm test && npm run build",
    "agent": "node server/index.js",
    "dev:web": "vite",
    "dev:agent": "node --watch server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ssh2-sftp-client": "^12.0.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
